/* 登录页面样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.login-card {
  width: 100%;
  max-width: 600rpx;
  background: white;
  border-radius: 40rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.logo-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

.logo-placeholder {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(145deg, #2d6a4f, #52b788);
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(45, 106, 79, 0.35);
}

.logo-text-cn {
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1.1;
  letter-spacing: 4rpx;
}

.logo-text-sub {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 6rpx;
  margin-top: 2rpx;
}

.wechat-btn {
  background: linear-gradient(135deg, #07c160, #06ad56) !important;
}

.success-section {
  text-align: center;
  padding: 40rpx;
}

.success-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.success-text {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.app-name {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.app-desc {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.features {
  display: flex;
  justify-content: space-around;
  margin-bottom: 60rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #f0fdf4, #dcfce7);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.feature-icon {
  font-size: 44rpx;
}

.feature-text {
  font-size: 22rpx;
  color: #555;
  font-weight: 500;
}

.login-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.3);
}

.login-btn::after {
  border: none;
}

.wechat-icon {
  margin-right: 10rpx;
  font-size: 36rpx;
}

.room-section {
  margin-top: 40rpx;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
}

.room-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}

.room-hint {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 30rpx;
}

.room-input {
  width: 100%;
  height: 80rpx;
  background: white;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  border: 2rpx solid #e0e0e0;
  margin-bottom: 20rpx;
}

.confirm-btn {
  width: 100%;
  height: 80rpx;
  background: #667eea;
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.confirm-btn::after {
  border: none;
}

/* 隐私政策勾选区域 */
.privacy-checkbox-section {
  margin-bottom: 30rpx;
}

.checkbox-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 10rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #ccc;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-color: #667eea;
}

.checkbox.checked text {
  color: white;
  font-size: 24rpx;
  font-weight: bold;
}

.checkbox-label {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  flex: 1;
}

.checkbox-label .link {
  color: #667eea;
}

/* 按钮禁用状态 */
.btn-disabled {
  opacity: 0.5 !important;
  background: #ccc !important;
  box-shadow: none !important;
}

/* 隐私提示 */
.privacy-hint {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  margin-top: 20rpx;
}

.link {
  color: #667eea;
}
