<!--小程序登录页面-->
<view class="container">
  <view class="login-card">
    <!-- Logo -->
    <view class="logo-section">
      <view class="logo-placeholder">
        <text class="logo-text-cn">翠友</text>
        <text class="logo-text-sub">雅集</text>
      </view>
      <text class="app-name">翠友雅集</text>
      <text class="app-desc">邻里闲置 · 智慧共享平台</text>
    </view>

    <!-- 功能介绍 -->
    <view class="features">
      <view class="feature-item">
        <view class="feature-icon-wrap">
          <text class="feature-icon">🏘️</text>
        </view>
        <text class="feature-text">同小区橱窗</text>
      </view>
      <view class="feature-item">
        <view class="feature-icon-wrap">
          <text class="feature-icon">🤖</text>
        </view>
        <text class="feature-text">AI智能推荐</text>
      </view>
      <view class="feature-item">
        <view class="feature-icon-wrap">
          <text class="feature-icon">🔐</text>
        </view>
        <text class="feature-text">安全可靠</text>
      </view>
    </view>

    <!-- 隐私政策勾选 -->
    <view class="privacy-checkbox-section" wx:if="{{!isLogin && !needSetRoom}}">
      <view class="checkbox-row" bindtap="toggleAgreement">
        <view class="checkbox {{agreedPrivacy ? 'checked' : ''}}">
          <text wx:if="{{agreedPrivacy}}">✓</text>
        </view>
        <view class="checkbox-label">
          <text>我已阅读并同意</text>
          <text class="link" catchtap="onUserAgreement">《用户服务协议》</text>
          <text>及</text>
          <text class="link" catchtap="onPrivacyPolicy">《隐私政策》</text>
        </view>
      </view>
    </view>

    <!-- 微信快捷登录按钮 -->
    <button class="login-btn wechat-btn {{!agreedPrivacy ? 'btn-disabled' : ''}}" bindtap="onWechatLogin" wx:if="{{!isLogin && !needSetRoom}}" loading="{{loading}}">
      <text class="wechat-icon">💚</text>
      微信快捷登录
    </button>

    <!-- 房间号设置区域 -->
    <view class="room-section" wx:if="{{needSetRoom}}">
      <view class="room-title">
        <text>🏠 请设置您的房间号</text>
      </view>
      <view class="room-hint">
        格式：楼号-单元号-房间号（如：1-2-345） #没有单元号的楼单元号默认填“1”(如：5-xxxx)
      </view>
      <input 
        class="room-input" 
        placeholder="请输入房间号" 
        value="{{roomNumber}}"
        bindinput="onRoomInput"
      />
      <button class="confirm-btn" bindtap="onConfirmRoom" loading="{{loading}}">确认</button>
    </view>

    <!-- 登录成功提示 -->
    <view class="success-section" wx:if="{{isLogin && !needSetRoom}}">
      <text class="success-icon">✅</text>
      <text class="success-text">登录成功</text>
    </view>

    <!-- 隐私提示 -->
    <view class="privacy-hint" wx:if="{{!isLogin && !needSetRoom}}">
      <text>请先阅读并勾选同意协议后登录</text>
    </view>
  </view>
</view>
