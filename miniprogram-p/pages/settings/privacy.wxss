.page {
  background-color: #ffffff;
}

.content-scroll {
  padding: 30rpx;
  box-sizing: border-box;
}

.privacy-content {
  padding-bottom: 60rpx;
}

.intro {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
}

.intro-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 16rpx;
  text-align: justify;
}

.intro-text:last-child {
  margin-bottom: 0;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.subsection {
  margin: 20rpx 0;
  padding-left: 20rpx;
}

.subsection-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #444444;
  margin-bottom: 12rpx;
}

.section-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 16rpx;
  text-align: justify;
}

.section-text.highlight {
  color: #ff6b35;
  font-weight: 500;
}

.footer {
  margin-top: 60rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #eeeeee;
  text-align: center;
}

.update-time {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 10rpx;
}
