.page {
  background-color: #ffffff;
}

.content-scroll {
  padding: 30rpx;
  box-sizing: border-box;
}

.agreement-content {
  padding-bottom: 60rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.section-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 16rpx;
  text-align: justify;
}

.footer {
  margin-top: 60rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #eeeeee;
  text-align: center;
}

.update-time {
  font-size: 24rpx;
  color: #999999;
}
