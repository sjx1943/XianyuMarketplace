<view class="container">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索闲置物品" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="onSearch" />
    <button class="search-btn" bindtap="onSearch">搜索</button>
  </view>

  <scroll-view class="category-scroll" scroll-x="true">
    <view class="category-list">
      <view 
        wx:for="{{categories}}" 
        wx:key="*this" 
        class="category-item {{currentCategory === item ? 'active' : ''}}"
        bindtap="onCategoryChange"
        data-category="{{item}}"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <view class="product-grid">
    <!-- 骨架屏：首次加载时显示 -->
    <block wx:if="{{loading && products.length === 0}}">
      <view class="product-card skeleton-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
        <view class="skeleton-image skeleton-animate"></view>
        <view class="product-info">
          <view class="skeleton-text skeleton-animate" style="width: 80%; height: 28rpx;"></view>
          <view class="skeleton-text skeleton-animate" style="width: 60%; height: 24rpx; margin-top: 16rpx;"></view>
          <view class="skeleton-text skeleton-animate" style="width: 40%; height: 22rpx; margin-top: 12rpx;"></view>
        </view>
      </view>
    </block>
    
    <!-- 商品列表 -->
    <view 
      wx:for="{{products}}" 
      wx:key="id" 
      class="product-card"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <image class="product-image" src="{{item.image}}" mode="aspectFill" lazy-load="true" />
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <view class="product-meta">
          <text class="product-transfer-price {{item.price > 0 ? 'price-paid' : (item.price === 0 || item.price === '0' ? 'price-free' : 'price-negotiable')}}">{{item.price > 0 ? '¥' + item.price : (item.price === 0 || item.price === '0' ? '免费领取' : '面议')}}</text>
          <text class="product-condition" wx:if="{{item.condition}}">{{item.condition}}</text>
        </view>
        <text class="product-tag">{{item.tag}}</text>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading && products.length > 0}}">
    <text>加载中...</text>
  </view>

  <view class="no-more" wx:if="{{!hasMore && products.length > 0}}">
    <text>没有更多了</text>
  </view>

  <view class="empty" wx:if="{{!loading && products.length === 0}}">
    <text>暂无闲置物品</text>
  </view>

  <view class="publish-btn" bindtap="goToPublish">
    <text class="publish-icon">+</text>
    <text class="publish-text">发布</text>
  </view>
</view>
