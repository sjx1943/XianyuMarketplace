/* 卖家店铺页面样式 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 卖家信息卡片 */
.seller-card {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 25rpx;
  color: white;
}

.seller-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.seller-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.seller-name {
  font-size: 36rpx;
  font-weight: bold;
}

.seller-room {
  font-size: 26rpx;
  opacity: 0.9;
}

.seller-stats {
  font-size: 24rpx;
  opacity: 0.8;
}

.seller-actions {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 12rpx 25rpx;
  border-radius: 30rpx;
  border: none;
  min-width: 140rpx;
}

.action-btn::after {
  border: none;
}

.chat-btn {
  background: white;
  color: #ff6b35;
}

.more-btn {
  background: rgba(255, 255, 255, 0.3);
  color: white;
}

/* 分区标题 */
.section-title {
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 物品网格 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
  gap: 20rpx;
}

.product-item {
  width: calc(50% - 10rpx);
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.product-image {
  width: 100%;
  height: 320rpx;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.product-price {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: bold;
}

.product-transfer-price {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 40rpx;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx;
  color: #999;
  font-size: 28rpx;
}

/* 操作菜单 */
.action-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.action-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.action-sheet-content {
  background: white;
  border-radius: 24rpx 24rpx 0 0;
  padding: 20rpx;
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  padding: 30rpx;
  font-size: 32rpx;
  color: #333;
}

.action-item:active {
  background: #f5f5f5;
}

.action-icon {
  font-size: 36rpx;
}

.action-cancel {
  background: white;
  margin-top: 15rpx;
  padding: 30rpx;
  text-align: center;
  font-size: 32rpx;
  color: #999;
}

.action-cancel:active {
  background: #f5f5f5;
}
