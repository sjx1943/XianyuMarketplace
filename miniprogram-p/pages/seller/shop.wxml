<!--邻居主页-->
<view class="page">
  <!-- 邻居信息卡片 -->
  <view class="seller-card">
    <image class="seller-avatar" src="{{seller.avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
    <view class="seller-info">
      <text class="seller-name">{{seller.nickname || seller.username || '匿名邻居'}}</text>
      <text class="seller-room">📍 {{seller.room_number || '未设置位置'}}</text>
      <text class="seller-stats">已分享 {{products.length}} 件闲置</text>
    </view>
    <view class="seller-actions">
      <button class="action-btn chat-btn" bindtap="onChat" wx:if="{{!isMe}}">💬 联系TA</button>
      <button class="action-btn more-btn" bindtap="showActionSheet" wx:if="{{!isMe}}">更多</button>
    </view>
  </view>

  <!-- 物品列表 -->
  <view class="section-title" wx:if="{{products.length > 0}}">
    <text>TA的物品</text>
  </view>
  
  <view class="product-grid" wx:if="{{!loading && products.length > 0}}">
    <view 
      class="product-item"
      wx:for="{{products}}"
      wx:key="id"
      bindtap="viewDetail"
      data-id="{{item.id}}"
    >
      <image class="product-image" src="{{item.imageUrl}}" mode="aspectFill"></image>
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <text class="product-transfer-price">{{item.price > 0 ? '出手价 ' + item.price : (item.price === 0 || item.price === '0' ? '免费' : '面议')}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && products.length === 0}}">
    <text class="empty-icon">📦</text>
    <text class="empty-text">TA还没有分享闲置物品</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>

<!-- 操作菜单 -->
<view class="action-sheet-mask" wx:if="{{showActionMenu}}" bindtap="hideActionSheet"></view>
<view class="action-sheet" wx:if="{{showActionMenu}}">
  <view class="action-sheet-content">
    <view class="action-item" bindtap="onBlockUser">
      <text class="action-icon">🚫</text>
      <text class="action-text">加入黑名单</text>
    </view>
  </view>
  <view class="action-cancel" bindtap="hideActionSheet">取消</view>
</view>
