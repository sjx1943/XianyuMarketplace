modules = ["python-3.11", "postgresql-16"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "tornado-server"

[[workflows.workflow]]
name = "tornado-server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python init_db.py && python app.py --port=5000"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 36719
externalPort = 3000

[[ports]]
localPort = 40271
externalPort = 3001

[[ports]]
localPort = 40935
externalPort = 3003

[[ports]]
localPort = 43289
externalPort = 3002

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
run = ["python", "app.py", "--port=5000"]
