<!--小程序登录页面-->
<view class="container">
  <view class="login-card">
    <!-- Logo -->
    <view class="logo-section">
      <view class="logo-placeholder">
        <text class="logo-icon">🏪</text>
      </view>
      <text class="app-name">翡翠之星平台</text>
      <text class="app-desc">邻里闲置展示平台</text>
    </view>

    <!-- 功能介绍 -->
    <view class="features">
      <view class="feature-item">
        <text class="feature-icon">🏠</text>
        <text class="feature-text">同小区物品橱窗</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">💬</text>
        <text class="feature-text">实时聊天</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">✅</text>
        <text class="feature-text">安全可靠</text>
      </view>
    </view>

    <!-- 微信快捷登录按钮 -->
    <button class="login-btn wechat-btn" bindtap="onWechatLogin" wx:if="{{!isLogin && !needSetRoom}}" loading="{{loading}}">
      <text class="wechat-icon">💚</text>
      微信快捷登录
    </button>

    <!-- 房间号设置区域 -->
    <view class="room-section" wx:if="{{needSetRoom}}">
      <view class="room-title">
        <text>🏠 请设置您的房间号</text>
      </view>
      <view class="room-hint">
        格式：楼号-单元号-房间号（如：3-1-901）
      </view>
      <input 
        class="room-input" 
        placeholder="请输入房间号" 
        value="{{roomNumber}}"
        bindinput="onRoomInput"
      />
      <button class="confirm-btn" bindtap="onConfirmRoom" loading="{{loading}}">确认</button>
    </view>

    <!-- 登录成功提示 -->
    <view class="success-section" wx:if="{{isLogin && !needSetRoom}}">
      <text class="success-icon">✅</text>
      <text class="success-text">登录成功</text>
    </view>

    <!-- 隐私政策 -->
    <view class="privacy-text">
      <text>登录即表示同意</text>
      <text class="link" bindtap="onUserAgreement">《用户协议》</text>
      <text>和</text>
      <text class="link" bindtap="onPrivacyPolicy">《隐私政策》</text>
    </view>
  </view>
</view>
