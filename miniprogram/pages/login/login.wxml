<!--小程序登录页面-->
<view class="container">
  <view class="login-card">
    <!-- Logo -->
    <view class="logo-section">
      <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
      <text class="app-name">小区二手市场</text>
      <text class="app-desc">邻里闲置交易平台</text>
    </view>

    <!-- 功能介绍 -->
    <view class="features">
      <view class="feature-item">
        <text class="feature-icon">🏠</text>
        <text class="feature-text">同小区交易</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">💬</text>
        <text class="feature-text">实时聊天</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">✅</text>
        <text class="feature-text">安全可靠</text>
      </view>
    </view>

    <!-- 登录按钮 -->
    <button class="login-btn" open-type="getUserInfo" bindgetuserinfo="onGetUserInfo" wx:if="{{!isLogin}}">
      <text class="wechat-icon">🔐</text>
      微信快捷登录
    </button>

    <!-- 房间号设置区域 -->
    <view class="room-section" wx:if="{{needSetRoom}}">
      <view class="room-title">
        <text>🏠 请设置您的房间号</text>
      </view>
      <view class="room-hint">
        格式：楼号-单元号-房间号（如：3-1-801）
      </view>
      <input 
        class="room-input" 
        placeholder="请输入房间号" 
        value="{{roomNumber}}"
        bindinput="onRoomInput"
      />
      <button class="confirm-btn" bindtap="onConfirmRoom">确认</button>
    </view>

    <!-- 隐私政策 -->
    <view class="privacy-text">
      <text>登录即表示同意</text>
      <text class="link">《用户协议》</text>
      <text>和</text>
      <text class="link">《隐私政策》</text>
    </view>
  </view>
</view>
