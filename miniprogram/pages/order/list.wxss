/* 订单列表页样式 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

/* Tabs */
.tabs {
  background: white;
  display: flex;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  position: relative;
  padding: 30rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.tab-item.active {
  color: #ff6b35;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #ff6b35;
  border-radius: 3rpx;
}

.tab-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #ff6b35;
  color: white;
  border-radius: 16rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 订单列表 */
.order-list {
  flex: 1;
  padding: 20rpx;
}

.order-item {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #f8f9fa;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-number {
  font-size: 24rpx;
  color: #666;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

.status-pending {
  color: #ffa500;
}

.status-shipped {
  color: #2196f3;
}

.status-completed {
  color: #4caf50;
}

.status-cancelled {
  color: #999;
}

.order-content {
  display: flex;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.product-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 10rpx;
}

.product-meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: bold;
}

.quantity {
  font-size: 26rpx;
  color: #666;
}

.order-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.action-buttons {
  display: flex;
  gap: 15rpx;
}

.btn-cancel,
.btn-confirm,
.btn-contact,
.btn-delete {
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  border: none;
  background: transparent;
}

.btn-cancel::after,
.btn-confirm::after,
.btn-contact::after,
.btn-delete::after {
  border: none;
}

.btn-cancel {
  border: 1rpx solid #ddd;
  color: #666;
}

.btn-confirm {
  background: #ff6b35;
  color: white;
}

.btn-contact {
  border: 1rpx solid #ff6b35;
  color: #ff6b35;
}

.btn-delete {
  border: 1rpx solid #ff4d4f;
  color: #ff4d4f;
}
