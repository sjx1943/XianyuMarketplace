<!--订单列表页-->
<view class="page">
  <!-- Tab切换 -->
  <view class="tabs">
    <view 
      wx:for="{{tabs}}" 
      wx:key="index"
      class="tab-item {{activeTab === index ? 'active' : ''}}"
      bindtap="switchTab"
      data-index="{{index}}"
    >
      <text>{{item.name}}</text>
      <view class="tab-badge" wx:if="{{item.badge > 0}}">{{item.badge}}</view>
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view class="order-list" scroll-y="{{true}}">
    <view 
      wx:for="{{orderList}}" 
      wx:key="id"
      class="order-item"
      bindtap="viewOrderDetail"
      data-order="{{item}}"
    >
      <!-- 订单头部 -->
      <view class="order-header">
        <text class="order-number">订单号：{{item.order_number}}</text>
        <text class="order-status status-{{item.status}}">{{item.status_text}}</text>
      </view>

      <!-- 商品信息 -->
      <view class="order-content">
        <image class="product-image" src="{{item.product_image}}"></image>
        <view class="product-info">
          <text class="product-name">{{item.product_name}}</text>
          <text class="product-meta">{{item.seller_room || item.buyer_room}}</text>
          <view class="price-row">
            <text class="price">¥{{item.price}}</text>
            <text class="quantity">x{{item.quantity || 1}}</text>
          </view>
        </view>
      </view>

      <!-- 订单操作 -->
      <view class="order-actions">
        <text class="order-time">{{item.created_at}}</text>
        <view class="action-buttons">
          <button 
            wx:if="{{item.can_cancel}}"
            class="btn-cancel"
            catchtap="cancelOrder"
            data-order="{{item}}"
          >
            取消订单
          </button>
          <button 
            wx:if="{{item.can_confirm}}"
            class="btn-confirm"
            catchtap="confirmOrder"
            data-order="{{item}}"
          >
            {{item.status === 'pending' ? '确认发货' : '确认收货'}}
          </button>
          <button 
            wx:if="{{item.can_contact}}"
            class="btn-contact"
            catchtap="contactUser"
            data-order="{{item}}"
          >
            联系{{activeTab === 0 ? '卖家' : '买家'}}
          </button>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && orderList.length === 0}}">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无订单</text>
      <button class="btn btn-primary" bindtap="goShopping">
        去逛逛
      </button>
    </view>

    <!-- 加载状态 -->
    <view class="loading" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>
  </scroll-view>
</view>
