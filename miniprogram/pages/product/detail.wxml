<!--商品详情页-->
<view class="page">
  <!-- 图片轮播 -->
  <view class="swiper-container" wx:if="{{product.images && product.images.length > 0}}">
    <swiper class="product-swiper" indicator-dots="{{true}}" autoplay="{{false}}" circular="{{true}}" bindchange="onSwiperChange">
      <swiper-item wx:for="{{product.imageDetails}}" wx:key="id" data-index="{{index}}">
        <view class="swiper-item-wrapper">
          <image src="{{item.url}}" mode="aspectFill" class="swiper-image" bindtap="previewImage" data-url="{{item.url}}" binderror="onAvatarError"></image>
          <!-- 卖家可以删除和设置主图 -->
          <view class="image-controls" wx:if="{{isOwner && product.imageDetails.length > 1}}">
            <button class="img-btn delete-btn" bindtap="deleteImage" data-image-id="{{item.id}}" data-index="{{index}}" size="mini">🗑️ 删除</button>
            <button class="img-btn primary-btn" bindtap="setPrimaryImage" data-image-id="{{item.id}}" data-filename="{{item.filename}}" size="mini" wx:if="{{product.image !== item.filename}}">⭐ 设为主图</button>
            <text class="primary-badge" wx:if="{{product.image === item.filename}}">★ 主图</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <!-- 自己的商品时显示"我的商品"按钮 -->
    <view class="image-control-bar" wx:if="{{isOwner}}">
      <button class="control-btn" bindtap="goToMyProducts">
        📦 我的商品
      </button>
    </view>
  </view>
  <view class="no-image" wx:else>
    <text>暂无商品图片</text>
  </view>

  <!-- 商品信息 -->
  <view class="product-info">
    <view class="product-header">
      <text class="product-name">{{product.name}}</text>
      <view class="product-price-row">
        <text class="product-price">¥{{product.price}}</text>
        <text class="original-price" wx:if="{{product.original_price}}">¥{{product.original_price}}</text>
      </view>
    </view>

    <view class="product-meta">
      <view class="meta-item">
        <text class="meta-icon">📍</text>
        <text class="meta-text">{{product.seller_room || '未设置'}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-icon">🕐</text>
        <text class="meta-text">{{product.created_at}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-icon">👁</text>
        <text class="meta-text">{{product.views || 0}}次浏览</text>
      </view>
    </view>

    <view class="product-tags">
      <text class="tag tag-condition">{{product.condition || '九成新'}}</text>
      <text class="tag" wx:for="{{product.tags}}" wx:key="index">{{item}}</text>
    </view>
  </view>

  <!-- 商品描述 -->
  <view class="product-description">
    <view class="section-title">📝 商品描述</view>
    <text class="description-text">{{product.description || '暂无描述'}}</text>
  </view>

  <!-- 卖家信息 -->
  <view class="seller-info" bindtap="viewSellerProfile">
    <image class="seller-avatar" src="{{product.seller_avatar}}"></image>
    <view class="seller-details">
      <text class="seller-name">{{product.seller_name || '匿名用户'}}</text>
      <text class="seller-room">房间号：{{product.seller_room}}</text>
    </view>
    <text class="arrow">></text>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <button class="action-btn" open-type="share">
      <text class="btn-icon">📤</text>
      <text class="btn-text">分享</text>
    </button>
    
    <!-- 他人商品：显示收藏、联系卖家、购买按钮 -->
    <block wx:if="{{!isOwner}}">
      <button class="action-btn" bindtap="onFavorite">
        <text class="btn-icon">{{product.is_favorited ? '❤️' : '🤍'}}</text>
        <text class="btn-text">收藏</text>
      </button>
      <button class="action-btn" bindtap="onChat">
        <text class="btn-icon">💬</text>
        <text class="btn-text">联系卖家</text>
      </button>
      <button class="action-btn" bindtap="onBuy">
        <text class="btn-icon">🛒</text>
        <text class="btn-text">购买</text>
      </button>
    </block>
    
    <!-- 自己的商品：显示编辑、删除按钮 -->
    <block wx:else>
      <button class="action-btn" bindtap="onEdit">
        <text class="btn-icon">✏️</text>
        <text class="btn-text">编辑</text>
      </button>
      <button class="action-btn delete-btn" bindtap="onDelete">
        <text class="btn-icon">🗑️</text>
        <text class="btn-text">删除</text>
      </button>
    </block>

    <!-- 返回主页按钮（所有用户都显示） -->
    <button class="action-btn" bindtap="goToHome">
      <text class="btn-icon">🏠</text>
      <text class="btn-text">返回</text>
    </button>
  </view>
</view>
