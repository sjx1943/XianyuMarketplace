/* 发布商品页样式 */
.page {
  padding-bottom: 120rpx;
  background: #f5f5f5;
}

/* 区块样式 */
.section {
  background: white;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.required {
  color: #ff6b35;
  font-size: 32rpx;
  margin-right: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-hint {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 图片上传 */
.image-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.image-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ff4444;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: 0 4rpx 8rpx rgba(255, 68, 68, 0.3);
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
  background: #fafafa;
}

.add-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.add-text {
  font-size: 24rpx;
}

/* 输入框 */
.input {
  width: 100%;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
  font-size: 28rpx;
}

/* 价格输入 */
.price-input {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 0 20rpx;
}

.currency {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b35;
  margin-right: 10rpx;
}

/* 选择器 */
.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.placeholder {
  color: #999;
}

.arrow {
  color: #999;
  font-size: 28rpx;
}

/* 成色选择 */
.condition-options {
  display: flex;
  gap: 20rpx;
}

.condition-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
  background: #f8f9fa;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.condition-item.active {
  background: #fff4f0;
  border-color: #ff6b35;
  color: #ff6b35;
}

.condition-item .icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

/* 文本域 */
.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 标签选择 */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.tag-item {
  padding: 15rpx 30rpx;
  background: #f8f9fa;
  border: 2rpx solid transparent;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.tag-item.active {
  background: #fff4f0;
  border-color: #ff6b35;
  color: #ff6b35;
}

/* 提交按钮 */
.submit-section {
  padding: 30rpx;
}

.submit-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8c61);
  color: white;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.3);
}

.submit-btn::after {
  border: none;
}

.submit-btn[loading] {
  opacity: 0.8;
}
