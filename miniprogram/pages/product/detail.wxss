/* 商品详情页样式 */
.page {
  padding-bottom: 120rpx;
  background: #f5f5f5;
}

/* 图片轮播 */
.product-swiper {
  width: 100%;
  height: 750rpx;
  background: white;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* 商品信息 */
.product-info {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.product-header {
  margin-bottom: 20rpx;
}

.product-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  line-height: 1.4;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 15rpx;
}

.product-price {
  font-size: 42rpx;
  color: #ff6b35;
  font-weight: bold;
}

.original-price {
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
}

/* 商品元信息 */
.product-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 28rpx;
}

.meta-text {
  font-size: 26rpx;
  color: #666;
}

/* 标签 */
.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 10rpx 20rpx;
  background: #f0f0f0;
  color: #666;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.tag-new {
  background: #e8f5e9;
  color: #4caf50;
}

.tag-like_new {
  background: #e3f2fd;
  color: #2196f3;
}

/* 商品描述 */
.product-description {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.description-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 卖家信息 */
.seller-info {
  background: white;
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.seller-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

.seller-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.seller-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.seller-room {
  font-size: 26rpx;
  color: #999;
}

.arrow {
  color: #999;
  font-size: 32rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 12rpx 16rpx 20rpx 16rpx;
  display: flex;
  gap: 10rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
  flex-wrap: wrap;
  justify-content: space-around;
  align-items: flex-start;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  padding: 8rpx;
  min-width: 70rpx;
  height: auto;
  font-size: 22rpx;
  color: #666;
  flex: 0 1 auto;
}

.action-btn::after {
  border: none;
}

.btn-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
  line-height: 1;
}

.btn-text {
  font-size: 20rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.chat-btn {
  flex: 1;
  background: white;
  border: 2rpx solid #ff6b35;
  color: #ff6b35;
  border-radius: 50rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.chat-btn::after {
  border: none;
}

.buy-btn {
  flex: 1;
  background: #ff6b35;
  color: white;
  border-radius: 50rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.buy-btn::after {
  border: none;
}

/* 删除按钮样式 */
.delete-btn {
  color: #ff4444;
}

/* 所有者标签 */
.owner-tag {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8f5e9;
  color: #4caf50;
  border-radius: 50rpx;
  height: 80rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* 无图片占位 */
.no-image {
  width: 100%;
  height: 400rpx;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}

/* 成色标签 */
.tag-condition {
  background: #fff3e0;
  color: #ff9800;
}

/* 图片编辑相关样式 */
.swiper-container {
  position: relative;
}

.swiper-item-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
}

.image-edit-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.delete-image-btn {
  background-color: #ff6b6b;
  color: white;
  padding: 20rpx 40rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.delete-image-btn::after {
  border: none;
}

.image-control-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-top: 1rpx solid #e0e0e0;
}

.control-btn {
  flex: 1;
  padding: 16rpx;
  background-color: #007bff;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.control-btn::after {
  border: none;
}

.control-btn.confirm-delete {
  background-color: #ff6b6b;
}

/* 评价区域样式 */
.review-section {
  background-color: #fff;
  margin: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.toggle-arrow {
  font-size: 24rpx;
  color: #999;
}

.review-action {
  padding: 20rpx 0;
  text-align: center;
}

.review-btn {
  display: inline-block;
  background-color: #ff6b35;
  color: #fff;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.comments-list {
  padding-top: 20rpx;
}

.comment-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.comment-user {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.comment-rating {
  font-size: 22rpx;
}

.comment-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 10rpx;
  display: block;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.no-comments {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 评价弹框样式 */
.review-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx;
  max-height: 80vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.rating-section {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.rating-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}

.rating-stars {
  display: flex;
  gap: 10rpx;
}

.rating-stars .star {
  font-size: 48rpx;
  cursor: pointer;
}

.review-textarea {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.submit-review-btn {
  width: 100%;
  background-color: #ff6b35;
  color: #fff;
  border-radius: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.submit-review-btn::after {
  border: none;
}
