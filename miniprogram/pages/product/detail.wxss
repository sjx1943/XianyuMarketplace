/* 商品详情页样式 */
.page {
  padding-bottom: 120rpx;
  background: #f5f5f5;
}

/* 图片轮播 */
.product-swiper {
  width: 100%;
  height: 750rpx;
  background: white;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* 商品信息 */
.product-info {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.product-header {
  margin-bottom: 20rpx;
}

.product-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  line-height: 1.4;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 15rpx;
}

.product-price {
  font-size: 42rpx;
  color: #ff6b35;
  font-weight: bold;
}

.original-price {
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
}

/* 商品元信息 */
.product-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 28rpx;
}

.meta-text {
  font-size: 26rpx;
  color: #666;
}

/* 标签 */
.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 10rpx 20rpx;
  background: #f0f0f0;
  color: #666;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.tag-new {
  background: #e8f5e9;
  color: #4caf50;
}

.tag-like_new {
  background: #e3f2fd;
  color: #2196f3;
}

/* 商品描述 */
.product-description {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.description-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 卖家信息 */
.seller-info {
  background: white;
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.seller-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

.seller-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.seller-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.seller-room {
  font-size: 26rpx;
  color: #999;
}

.arrow {
  color: #999;
  font-size: 32rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  display: flex;
  gap: 15rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  padding: 0;
  width: 100rpx;
  height: 100rpx;
  font-size: 24rpx;
  color: #666;
}

.action-btn::after {
  border: none;
}

.btn-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.btn-text {
  font-size: 22rpx;
}

.chat-btn {
  flex: 1;
  background: white;
  border: 2rpx solid #ff6b35;
  color: #ff6b35;
  border-radius: 50rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.chat-btn::after {
  border: none;
}

.buy-btn {
  flex: 1;
  background: #ff6b35;
  color: white;
  border-radius: 50rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.buy-btn::after {
  border: none;
}

/* 删除按钮样式 */
.delete-btn {
  color: #ff4444;
}

/* 所有者标签 */
.owner-tag {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8f5e9;
  color: #4caf50;
  border-radius: 50rpx;
  height: 80rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* 无图片占位 */
.no-image {
  width: 100%;
  height: 400rpx;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}

/* 成色标签 */
.tag-condition {
  background: #fff3e0;
  color: #ff9800;
}

/* 图片编辑相关样式 */
.swiper-container {
  position: relative;
}

.swiper-item-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
}

.image-edit-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.delete-image-btn {
  background-color: #ff6b6b;
  color: white;
  padding: 20rpx 40rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.delete-image-btn::after {
  border: none;
}

.image-control-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-top: 1rpx solid #e0e0e0;
}

.control-btn {
  flex: 1;
  padding: 16rpx;
  background-color: #007bff;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.control-btn::after {
  border: none;
}

.control-btn.confirm-delete {
  background-color: #ff6b6b;
}
