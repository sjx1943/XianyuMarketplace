/* 个人中心页样式 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 30rpx 40rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 25rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.room-number {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.edit-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: white;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
}

.arrow {
  color: white;
  font-size: 28rpx;
}

/* 统计卡片 */
.stats-card {
  background: white;
  border-radius: 16rpx;
  margin: 0 30rpx 20rpx;
  display: flex;
  padding: 40rpx 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
  border-right: 1rpx solid #f0f0f0;
}

.stat-item:last-child {
  border-right: none;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b35;
}

.stat-label {
  font-size: 26rpx;
  color: #666;
}

/* 菜单区域 */
.menu-section {
  background: white;
  border-radius: 16rpx;
  margin: 0 30rpx 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 35rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: white;
  border-radius: 0;
  border: none;
  text-align: left;
  font-size: 28rpx;
  line-height: 1;
}

.menu-item::after {
  border: none;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.menu-icon {
  font-size: 40rpx;
  width: 50rpx;
  text-align: center;
}

.menu-title {
  font-size: 30rpx;
  color: #333;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.badge {
  background: #ff6b35;
  color: white;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.arrow {
  color: #999;
  font-size: 28rpx;
}

/* 退出登录 */
.logout-section {
  margin: 0 30rpx;
  margin-top: 40rpx;
}

.logout-btn {
  width: 100%;
  height: 90rpx;
  background: white;
  color: #ff4444;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.logout-btn::after {
  border: none;
}

/* 版本信息 */
.version-info {
  text-align: center;
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #999;
}
