<view class="container">
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <block wx:if="{{!loading}}">
    <view class="form-section">
      <view class="section-title">个人头像</view>
      
      <view class="avatar-container">
        <image class="avatar-preview" src="{{avatar || defaultAvatar}}"></image>
        <view class="avatar-actions">
          <button class="avatar-btn" bindtap="chooseAvatar">选择头像</button>
          <button class="avatar-btn secondary" bindtap="useDefaultAvatar">使用默认</button>
        </view>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">个人信息</view>
      
      <view class="form-item">
        <text class="label">用户名</text>
        <input 
          class="input" 
          placeholder="请输入用户名" 
          value="{{username}}"
          bindinput="onUsernameInput"
        />
      </view>

      <view class="form-item">
        <text class="label">房间号</text>
        <input 
          class="input" 
          placeholder="格式：楼栋-单元-房号 (如：3-1-801)" 
          value="{{roomNumber}}"
          bindinput="onRoomNumberInput"
        />
      </view>
    </view>

    <!-- 手机号绑定区域 -->
    <view class="form-section">
      <view class="section-title">手机号绑定</view>
      <view class="phone-bind-tip">绑定手机号后，可使用该手机号在网页端登录</view>
      
      <!-- 已绑定手机号 -->
      <block wx:if="{{phone}}">
        <view class="form-item phone-bound">
          <text class="label">已绑定</text>
          <view class="phone-display">
            <text class="phone-number">{{phoneDisplay}}</text>
            <button class="unbind-btn" size="mini" bindtap="onUnbindPhone">解绑</button>
          </view>
        </view>
      </block>

      <!-- 未绑定手机号 - 绑定流程 -->
      <block wx:else>
        <view class="form-item">
          <text class="label">手机号</text>
          <input 
            class="input phone-input" 
            type="number"
            maxlength="11"
            placeholder="请输入11位手机号" 
            value="{{newPhone}}"
            bindinput="onNewPhoneInput"
          />
        </view>

        <view class="form-item" wx:if="{{showCodeInput}}">
          <text class="label">验证码</text>
          <view class="code-input-group">
            <input 
              class="input code-input" 
              type="number"
              maxlength="6"
              placeholder="请输入验证码" 
              value="{{verifyCode}}"
              bindinput="onCodeInput"
            />
            <button 
              class="send-code-btn {{countdown > 0 ? 'disabled' : ''}}" 
              size="mini"
              bindtap="onSendCode"
              disabled="{{countdown > 0 || sendingCode}}"
            >
              {{countdown > 0 ? countdown + 's' : (sendingCode ? '发送中' : '获取验证码')}}
            </button>
          </view>
        </view>

        <button 
          wx:if="{{!showCodeInput}}"
          class="bind-btn" 
          bindtap="onStartBind"
          disabled="{{!newPhone || newPhone.length !== 11}}"
        >
          下一步
        </button>

        <button 
          wx:if="{{showCodeInput}}"
          class="bind-btn" 
          bindtap="onBindPhone"
          disabled="{{!verifyCode || verifyCode.length !== 6 || binding}}"
        >
          {{binding ? '绑定中...' : '确认绑定'}}
        </button>
      </block>
    </view>

    <view class="tips">
      <text class="tip-title">说明：</text>
      <text class="tip-content">1. 房间号格式为 楼栋-单元-房号，例如 3-1-801</text>
      <text class="tip-content">2. 绑定手机号后，可使用手机号+验证码在网页端登录</text>
    </view>

    <button class="save-btn" bindtap="saveProfile" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存修改'}}
    </button>
  </block>
</view>
