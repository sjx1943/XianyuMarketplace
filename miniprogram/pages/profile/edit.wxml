<view class="container">
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <block wx:if="{{!loading}}">
    <view class="form-section">
      <view class="section-title">个人信息</view>
      
      <view class="form-item">
        <text class="label">用户名</text>
        <input 
          class="input" 
          placeholder="请输入用户名" 
          value="{{username}}"
          bindinput="onUsernameInput"
        />
      </view>

      <view class="form-item">
        <text class="label">手机号</text>
        <input 
          class="input" 
          type="number"
          maxlength="11"
          placeholder="请输入手机号" 
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>

      <view class="form-item">
        <text class="label">房间号</text>
        <input 
          class="input" 
          placeholder="格式：楼栋-单元-房号 (如：3-1-801)" 
          value="{{roomNumber}}"
          bindinput="onRoomNumberInput"
        />
      </view>
    </view>

    <view class="tips">
      <text class="tip-title">房间号说明：</text>
      <text class="tip-content">格式为 楼栋-单元-房号，例如 3-1-801 表示3号楼1单元801室</text>
    </view>

    <button class="save-btn" bindtap="saveProfile" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存修改'}}
    </button>
  </block>
</view>
