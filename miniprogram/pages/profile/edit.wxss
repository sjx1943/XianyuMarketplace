.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.form-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.avatar-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  margin-bottom: 30rpx;
  background-color: #f0f0f0;
}

.avatar-actions {
  display: flex;
  gap: 15rpx;
  width: 100%;
  justify-content: center;
}

.avatar-btn {
  flex: 1;
  max-width: 180rpx;
  height: 60rpx;
  background-color: #ff6b35;
  color: white;
  font-size: 26rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn.secondary {
  background-color: #999;
}

.avatar-btn::after {
  border: none;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 10rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  text-align: right;
}

.value.readonly {
  color: #999;
}

.input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: #333;
  line-height: 1.5;
  min-height: 44rpx;
}

/* 手机号绑定区域样式 */
.phone-bind-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.phone-bound {
  background-color: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx !important;
  margin: 10rpx 0;
}

.phone-display {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}

.phone-number {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 500;
}

.unbind-btn {
  background-color: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  line-height: 1.5;
}

.unbind-btn::after {
  border: none;
}

.phone-input {
  flex: 1;
}

.code-input-group {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 15rpx;
}

.code-input {
  flex: 1;
  max-width: 200rpx;
}

.send-code-btn {
  background-color: #ff6b35;
  color: #fff;
  font-size: 22rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  line-height: 1.5;
  white-space: nowrap;
}

.send-code-btn.disabled {
  background-color: #ccc;
  color: #fff;
}

.send-code-btn::after {
  border: none;
}

.bind-btn {
  width: 100%;
  height: 80rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
}

.bind-btn[disabled] {
  background-color: #ccc;
  color: #fff;
}

.bind-btn::after {
  border: none;
}

.tips {
  background-color: #fff9f5;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
}

.tip-title {
  font-size: 26rpx;
  color: #ff6b35;
  font-weight: 500;
  display: block;
  margin-bottom: 10rpx;
}

.tip-content {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  display: block;
  margin-bottom: 6rpx;
}

.tip-content:last-child {
  margin-bottom: 0;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background-color: #ff6b35;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn[disabled] {
  opacity: 0.6;
}
