<!--个人中心页-->
<view class="page">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <image class="avatar" src="{{userInfo.wechat_avatar}}"></image>
    <view class="user-info">
      <text class="username">{{userInfo.wechat_nickname || userInfo.username || '未设置'}}</text>
      <text class="room-number">🏠 {{userInfo.room_number || '未设置房间号'}}</text>
    </view>
    <navigator class="edit-btn" url="/pages/profile/edit">
      <text>编辑</text>
      <text class="arrow">></text>
    </navigator>
  </view>

  <!-- 我的商品统计 -->
  <view class="stats-card">
    <navigator class="stat-item" url="/pages/product/my-list?type=selling">
      <text class="stat-number">{{stats.selling || 0}}</text>
      <text class="stat-label">在售</text>
    </navigator>
    <navigator class="stat-item" url="/pages/product/my-list?type=sold">
      <text class="stat-number">{{stats.sold || 0}}</text>
      <text class="stat-label">已售</text>
    </navigator>
    <navigator class="stat-item" url="/pages/product/my-list?type=favorites">
      <text class="stat-number">{{stats.favorites || 0}}</text>
      <text class="stat-label">收藏</text>
    </navigator>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goToMyProducts">
      <view class="menu-left">
        <text class="menu-icon">📦</text>
        <text class="menu-title">我的商品</text>
      </view>
      <text class="arrow">></text>
    </view>

    <view class="menu-item" bindtap="goToMyOrders">
      <view class="menu-left">
        <text class="menu-icon">🛒</text>
        <text class="menu-title">我的订单</text>
      </view>
      <text class="arrow">></text>
    </view>

    <view class="menu-item" bindtap="goToMyMessages">
      <view class="menu-left">
        <text class="menu-icon">💬</text>
        <text class="menu-title">我的消息</text>
      </view>
      <view class="menu-right">
        <text class="badge" wx:if="{{unreadCount > 0}}">{{unreadCount}}</text>
        <text class="arrow">></text>
      </view>
    </view>
  </view>

  <!-- 设置菜单 -->
  <view class="menu-section">
    <navigator class="menu-item" url="/pages/settings/about">
      <view class="menu-left">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-title">关于我们</text>
      </view>
      <text class="arrow">></text>
    </navigator>

    <button class="menu-item" open-type="feedback">
      <view class="menu-left">
        <text class="menu-icon">📧</text>
        <text class="menu-title">意见反馈</text>
      </view>
      <text class="arrow">></text>
    </button>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>小区闲置平台 v1.0.1</text>
  </view>
</view>
