<!--聊天列表页-->
<view class="page">
  <view class="chat-list" wx:if="{{chatList.length > 0}}">
    <view 
      wx:for="{{chatList}}" 
      wx:key="id"
      class="chat-item"
      bindtap="openChat"
      data-friend="{{item}}"
    >
      <image class="avatar" src="{{item.avatar || '/images/default-avatar.png'}}"></image>
      
      <view class="chat-content">
        <view class="chat-header">
          <text class="friend-name">{{item.name}}</text>
          <text class="chat-time">{{item.last_message_time}}</text>
        </view>
        <view class="chat-preview">
          <text class="last-message">{{item.last_message || '暂无消息'}}</text>
          <view class="unread-badge" wx:if="{{item.unread_count > 0}}">
            {{item.unread_count > 99 ? '99+' : item.unread_count}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && chatList.length === 0}}">
    <text class="empty-icon">💬</text>
    <text class="empty-text">暂无聊天记录</text>
    <text class="empty-hint">浏览商品并联系卖家开始聊天</text>
    <button class="btn btn-primary" bindtap="goToProductList">
      去逛逛
    </button>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
</view>
