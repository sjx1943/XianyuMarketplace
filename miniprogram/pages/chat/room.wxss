/* 聊天室页面样式 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
  animation: fadeIn 0.3s;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message-item.mine {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0f0f0;
  object-fit: cover;
}

.message-item.mine .avatar {
  margin-left: 20rpx;
}

.message-item.other .avatar {
  margin-right: 20rpx;
}

.message-content {
  max-width: 500rpx;
  display: flex;
  flex-direction: column;
}

.message-item.mine .message-content {
  align-items: flex-end;
}

.message-item.other .message-content {
  align-items: flex-start;
}

/* 消息气泡 */
.message-bubble {
  background: white;
  padding: 20rpx 25rpx;
  border-radius: 16rpx;
  max-width: 100%;
  word-break: break-all;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.message-item.mine .message-bubble {
  background: #ff6b35;
  color: white;
  border-bottom-right-radius: 4rpx;
}

.message-item.other .message-bubble {
  background: white;
  border-bottom-left-radius: 4rpx;
}

/* 图片消息 */
.message-image {
  max-width: 400rpx;
  border-radius: 12rpx;
  display: block;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 商品卡片 */
.product-card {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  gap: 20rpx;
  max-width: 450rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-price {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: bold;
}

/* 消息时间 */
.message-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  white-space: nowrap;
}

.message-item.mine .message-time {
  text-align: right;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  display: block;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  display: block;
  color: #bbb;
}

/* 输入栏 */
.input-bar {
  background: white;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.tool-btn {
  width: 70rpx;
  height: 70rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}

.tool-btn::after {
  border: none;
}

.tool-btn .icon {
  font-size: 36rpx;
}

.message-input {
  flex: 1;
  background: #f8f9fa;
  border-radius: 35rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  height: 70rpx;
  box-sizing: border-box;
}

.send-btn {
  background: #ff6b35;
  color: white;
  border-radius: 35rpx;
  padding: 0 40rpx;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.send-btn::after {
  border: none;
}

/* 系统广播区块 */
.broadcast-section {
  background: #fff8f3;
  padding: 20rpx;
  margin: 20rpx 0;
  border-radius: 12rpx;
}

.broadcast-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}

.broadcast-item {
  background: white;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 8rpx;
  border-left: 4rpx solid #ff6b35;
  transition: background-color 0.2s;
}

.broadcast-item:active {
  background-color: #f8f9fa;
}

.broadcast-item:last-child {
  margin-bottom: 0;
}

.broadcast-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.broadcast-user {
  color: #ff6b35;
  font-weight: bold;
}

.broadcast-time-text {
  color: #999;
}

.broadcast-time {
  color: #999;
}

.broadcast-product {
  color: #333;
  font-weight: 500;
}

.broadcast-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin-top: 16rpx;
}
