/* 聊天列表页样式 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 30rpx;
}

/* 区块样式 */
.section {
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fafafa;
}

/* 聊天列表 */
.chat-list {
  background: white;
}

.chat-item-wrapper {
  position: relative;
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
  overflow: hidden;
}

.chat-item-wrapper:last-child {
  border-bottom: none;
}

.chat-item {
  display: flex;
  padding: 30rpx;
  transition: transform 0.3s ease;
  position: relative;
  width: 100%;
  background: white;
}

.chat-item.slide-left {
  transform: translateX(-100rpx);
}

.chat-item:active {
  background-color: #f8f9fa;
}

.delete-btn {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100rpx;
  background-color: #ff4d4f;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  z-index: 1;
  cursor: pointer;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.chat-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.friend-name-section {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.friend-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.room-number {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-time {
  font-size: 22rpx;
  color: #999;
  margin-left: 15rpx;
  flex-shrink: 0;
}

.chat-preview {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.last-message {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unread-badge {
  background: #ff6b35;
  color: white;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  margin-left: 15rpx;
  flex-shrink: 0;
}

/* 系统广播区块 */
.broadcast-section {
  background: #fff8f3;
}

.broadcast-section .section-title {
  background: #fff0e6;
  border-bottom-color: #ffe4d4;
}

.broadcast-list {
  padding: 15rpx;
}

.broadcast-item {
  background: white;
  padding: 20rpx 25rpx;
  margin-bottom: 15rpx;
  border-radius: 10rpx;
  border-left: 4rpx solid #ff6b35;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: background-color 0.2s;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
}

.broadcast-item:active {
  background-color: #f8f9fa;
}

.broadcast-item:last-child {
  margin-bottom: 0;
}

.broadcast-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.broadcast-user {
  color: #ff6b35;
  font-weight: bold;
}

.broadcast-time-text {
  color: #999;
}

.broadcast-time {
  color: #999;
}

.broadcast-product {
  color: #333;
  font-weight: 500;
}

.broadcast-arrow {
  color: #ccc;
  font-size: 32rpx;
  margin-left: 15rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  display: block;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  display: block;
  color: #bbb;
  margin-bottom: 30rpx;
}

.btn {
  display: inline-block;
  padding: 20rpx 50rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.btn-primary {
  background: #ff6b35;
  color: white;
}

.btn-primary:active {
  opacity: 0.8;
}

/* 无聊天记录提示 */
.no-chat-hint {
  padding: 20rpx;
}

.hint-box {
  background: #e8f4fd;
  padding: 20rpx 25rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
}

.hint-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #1890ff;
  flex: 1;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  color: #999;
  font-size: 26rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #ff6b35;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
