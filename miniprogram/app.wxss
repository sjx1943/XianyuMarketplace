/**app.wxss - 全局样式**/
page {
  height: 100%;
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
}

/* 通用样式 */
.container {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #f5f5f5;
}

.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  justify-content: center;
  align-items: center;
}

.flex-between {
  justify-content: space-between;
  align-items: center;
}

.flex-start {
  justify-content: flex-start;
  align-items: center;
}

.flex-end {
  justify-content: flex-end;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

.flex-wrap {
  flex-wrap: wrap;
}

/* 文本样式 */
.text-primary {
  color: #ff6b35;
}

.text-secondary {
  color: #6c757d;
}

.text-success {
  color: #28a745;
}

.text-danger {
  color: #dc3545;
}

.text-warning {
  color: #ffc107;
}

.text-muted {
  color: #999;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-left {
  text-align: left;
}

.text-bold {
  font-weight: bold;
}

.text-small {
  font-size: 24rpx;
}

.text-medium {
  font-size: 28rpx;
}

.text-large {
  font-size: 32rpx;
}

.text-xlarge {
  font-size: 36rpx;
}

/* 间距 */
.mt-5 { margin-top: 10rpx; }
.mt-10 { margin-top: 20rpx; }
.mt-20 { margin-top: 40rpx; }
.mt-30 { margin-top: 60rpx; }
.mt-40 { margin-top: 80rpx; }

.mb-5 { margin-bottom: 10rpx; }
.mb-10 { margin-bottom: 20rpx; }
.mb-20 { margin-bottom: 40rpx; }
.mb-30 { margin-bottom: 60rpx; }
.mb-40 { margin-bottom: 80rpx; }

.ml-10 { margin-left: 20rpx; }
.ml-20 { margin-left: 40rpx; }

.mr-10 { margin-right: 20rpx; }
.mr-20 { margin-right: 40rpx; }

.mx-auto { margin-left: auto; margin-right: auto; }

.p-5 { padding: 10rpx; }
.p-10 { padding: 20rpx; }
.p-20 { padding: 40rpx; }
.p-30 { padding: 60rpx; }

.pt-5 { padding-top: 10rpx; }
.pt-10 { padding-top: 20rpx; }
.pb-5 { padding-bottom: 10rpx; }
.pb-10 { padding-bottom: 20rpx; }
.pl-10 { padding-left: 20rpx; }
.pr-10 { padding-right: 20rpx; }

/* 按钮样式 */
.btn {
  padding: 20rpx 40rpx;
  border-radius: 10rpx;
  border: none;
  font-size: 28rpx;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s;
  display: inline-block;
  box-sizing: border-box;
}

.btn-primary {
  background-color: #ff6b35;
  color: white;
}

.btn-primary:active {
  background-color: #e55a1f;
  transform: scale(0.98);
}

.btn-secondary {
  background-color: #6c757d;
  color: white;
}

.btn-secondary:active {
  background-color: #5a6268;
}

.btn-success {
  background-color: #28a745;
  color: white;
}

.btn-success:active {
  background-color: #218838;
}

.btn-danger {
  background-color: #dc3545;
  color: white;
}

.btn-danger:active {
  background-color: #c82333;
}

.btn-outline {
  background-color: transparent;
  border: 2rpx solid #ff6b35;
  color: #ff6b35;
}

.btn-outline:active {
  background-color: #fff5f0;
}

.btn-small {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

.btn-large {
  padding: 30rpx 60rpx;
  font-size: 32rpx;
}

.btn-block {
  width: 100%;
  display: block;
}

.btn[disabled],
.btn.disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* 卡片样式 */
.card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.card-body {
  padding: 0;
}

.card-footer {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 表单样式 */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.form-label.required::after {
  content: ' *';
  color: #dc3545;
}

.form-input,
.form-textarea,
.form-select {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  font-size: 28rpx;
  background: white;
  box-sizing: border-box;
  color: #333;
}

.form-input:focus,
.form-textarea:focus,
.form-select:focus {
  border-color: #ff6b35;
  outline: none;
}

.form-input::placeholder,
.form-textarea::placeholder {
  color: #ccc;
}

.form-textarea {
  min-height: 120rpx;
  resize: vertical;
}

.form-error {
  color: #dc3545;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.form-help {
  color: #999;
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 列表样式 */
.list {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.list-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: background-color 0.3s;
}

.list-item:active {
  background-color: #f8f9fa;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-content {
  flex: 1;
}

.list-item-text {
  color: #333;
  font-size: 28rpx;
  margin-bottom: 10rpx;
}

.list-item-desc {
  color: #999;
  font-size: 24rpx;
}

/* 商品样式 */
.product-item {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.3s, box-shadow 0.3s;
}

.product-item:active {
  transform: translateY(-4rpx);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
}

.product-image {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
  background: #f0f0f0;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-height: 56rpx;
  line-height: 28rpx;
}

.product-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 24rpx;
  max-height: 48rpx;
}

.product-price {
  font-size: 36rpx;
  color: #ff6b35;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.product-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.product-seller {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 评分样式 */
.rating {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
}

.star {
  font-size: 28rpx;
  color: #ffd700;
}

.star.empty {
  color: #e0e0e0;
}

.rating-text {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  background: #f0f0f0;
  color: #666;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.tag-primary {
  background: #ff6b35;
  color: white;
}

.tag-success {
  background: #28a745;
  color: white;
}

.tag-warning {
  background: #ffc107;
  color: #333;
}

.tag-danger {
  background: #dc3545;
  color: white;
}

.tag-info {
  background: #17a2b8;
  color: white;
}

/* 状态样式 */
.badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: #f0f0f0;
  color: #666;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.badge-primary {
  background: #ff6b35;
  color: white;
}

.badge-success {
  background: #28a745;
  color: white;
}

.badge-warning {
  background: #ffc107;
  color: #333;
}

.badge-danger {
  background: #dc3545;
  color: white;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  margin-bottom: 30rpx;
  color: #999;
}

.empty-subtext {
  font-size: 24rpx;
  color: #ccc;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  color: #999;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f0f0f0;
  border-top: 4rpx solid #ff6b35;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 20rpx 0;
}

/* 网络错误提示 */
.network-error {
  background-color: #fff3cd;
  border: 1rpx solid #ffc107;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  color: #856404;
  font-size: 24rpx;
}

/* 响应式 */
@media (max-width: 750rpx) {
  .container {
    padding: 15rpx;
  }
  
  .card {
    padding: 20rpx;
    margin-bottom: 15rpx;
  }
  
  .product-image {
    height: 250rpx;
  }
  
  .btn {
    font-size: 26rpx;
    padding: 18rpx 36rpx;
  }
}
