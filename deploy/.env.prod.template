# ==========================================
# 翠友雅集S - VPS生产环境变量配置
# ==========================================
# 使用方法:
# 1. 复制此文件为 .env.prod: cp .env.prod.template ../.env.prod
# 2. 填入实际的密钥和密码
# 3. 确保权限安全: chmod 600 ../.env.prod
# ==========================================

# ========== PostgreSQL 数据库 (VPS自部署) ==========
PGDATABASE=secondhand_db
PGUSER=secondhand_user
PGPASSWORD=请填入强密码_至少16位
PGHOST=postgres
PGPORT=5432
DATABASE_URL=postgresql://secondhand_user:请填入强密码_至少16位@postgres:5432/secondhand_db

# ========== MongoDB Atlas (云服务，沿用原有连接) ==========
# 从Replit Secrets复制 MONGODB_URI
MONGODB_URI=mongodb+srv://用户名:密码@cluster.xxxxx.mongodb.net/chat_db?retryWrites=true&w=majority

# ========== Redis 缓存 ==========
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ========== 应用配置 ==========
SECRET_KEY=请生成一个32位以上的随机字符串
SESSION_SECRET=请生成另一个32位以上的随机字符串
DEBUG=False
PORT=8000
ENVIRONMENT=production

# ========== 域名配置 ==========
DOMAIN=happepls.pics
API_BASE_URL=https://happepls.pics:8543

# ========== 微信小程序配置 ==========
WX_MINIPROGRAM_APP_ID=wx4be72cc6e4cc1e59
WX_MINIPROGRAM_APP_SECRET=从Replit复制

# ========== 微信OAuth登录 (Web端，可选) ==========
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://happepls.pics:8543/wechat/callback

# ========== 阿里云SMS配置 ==========
ALIYUN_ACCESS_KEY_ID=从Replit复制
ALIYUN_ACCESS_KEY_SECRET=从Replit复制
ALIYUN_SMS_SIGN_NAME=从Replit复制
ALIYUN_SMS_TEMPLATE_CODE=从Replit复制

# ========== SMTP邮件配置 (可选) ==========
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=True

# ========== 日志配置 ==========
LOG_LEVEL=INFO

# ==========================================
# 安全提醒:
# 1. 不要将此文件提交到Git仓库
# 2. 定期更换密码和密钥
# 3. 使用强密码 (至少16个字符，含大小写+数字+符号)
# ==========================================
