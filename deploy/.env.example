# ==========================================
# 环境变量配置文件
# ==========================================
# Replit 开发环境: 使用 .env 或系统环境变量
# VPS 生产环境: 使用 .env.prod（在deploy/文件夹中复制此文件）
# ==========================================

# ========== 数据库配置 ==========

# PostgreSQL (主数据库)
# Replit: 使用 DATABASE_URL 环境变量
# VPS: 在docker-compose-prod.yml中配置，或在此设置完整URL
DATABASE_URL=postgres://user:password@postgres:5432/secondhand_db
PGHOST=postgres
PGPORT=5432
PGUSER=secondhand_user
PGPASSWORD=your_secure_password_here
PGDATABASE=secondhand_db

# MongoDB (聊天消息)
# Replit: 使用 MONGODB_URI 环境变量
# VPS: 在docker-compose-prod.yml中配置，或在此设置完整URL
MONGODB_URI=mongodb://mongo_user:mongo_password@mongo:27017/chat_db?authSource=admin
MONGODB_HOST=mongo
MONGODB_PORT=27017
MONGODB_DATABASE=chat_db

# Redis (可选缓存)
REDIS_URL=redis://redis:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ========== 应用配置 ==========

# Flask/Tornado应用
SECRET_KEY=your-secret-key-change-this-in-production
SESSION_SECRET=your-session-secret-key-change-this
DEBUG=False
PORT=8000

# ========== 微信配置 ==========

# 微信小程序
WX_MINIPROGRAM_APP_ID=wxXXXXXXXXXXXXXXXX
WX_MINIPROGRAM_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 微信OAuth登录（Web端）
WECHAT_APP_ID=wxXXXXXXXXXXXXXXXX
WECHAT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WECHAT_REDIRECT_URI=https://okashii.top/wechat/callback

# ========== 阿里云SMS配置 ==========

# 用于发送短信验证码
ALIYUN_ACCESS_KEY_ID=LTAI5t.....................
ALIYUN_ACCESS_KEY_SECRET=........................
ALIYUN_SMS_SIGN_NAME=小区交易平台
ALIYUN_SMS_TEMPLATE_CODE=SMS_XXXXXXX  # 验证码模板

# ========== 邮件SMTP配置 ==========

# 用于发送密码重置邮件
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-app-password  # QQ邮箱需要使用授权码
SMTP_USE_SSL=True
SMTP_FROM_EMAIL=noreply@example.com

# ========== 第三方服务 ==========

# 日志服务（可选）
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# 分析服务（可选）
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# ========== VPS部署专用配置 ==========

# 应用环境
ENVIRONMENT=production
DOMAIN=okashii.top
SSL_ENABLED=true

# 容器配置
WORKERS=4
WORKER_CLASS=tornado
WORKER_TIMEOUT=30

# 日志级别
LOG_LEVEL=INFO
LOG_FORMAT=json

# 备份配置
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # 每天凌晨2点备份
BACKUP_RETENTION_DAYS=30

# ========== Replit开发环境专用配置 ==========

# Replit提供的环境变量（自动设置，无需修改）
# DATABASE_URL - PostgreSQL连接字符串
# MONGODB_URI - MongoDB连接字符串（如果创建了数据库）

# 开发模式
DEV_MODE=true
REPLIT_DOMAIN=your-repl-name.yourname.repl.co

# ========== 敏感信息提醒 ==========

# ⚠️  重要: 不要将实际的密钥和密码提交到版本控制
# 使用此文件作为模板，在VPS和Replit中分别管理敏感信息
# 
# Replit: 使用Secrets选项卡管理敏感信息
# VPS: 使用 sudo chmod 600 .env.prod 限制访问权限
#
# 推荐做法:
# - 定期轮换API密钥
# - 使用强密码（至少16个字符，包含大小写字母+数字+符号）
# - 限制数据库用户权限（仅给予必要权限）
# - 启用IP白名单（如果可能）
